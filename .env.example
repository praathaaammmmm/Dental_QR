APP_ENV=development
CLINIC_USERNAME=smritiraj-clinic
CLINIC_PASSWORD_HASH=
SESSION_SECRET_KEY=
QR_SIGNING_KEY=
SESSION_MAX_AGE_SECONDS=1800
SESSION_HTTPS_ONLY=false
SESSION_VERSION=1
# If n8n runs in Docker locally (e.g. Docker Desktop on Windows) and needs to call this
# CRM's callback endpoint at http://host.docker.internal:8000, append host.docker.internal
# to your existing comma-separated list below — do not replace the list, add to it — e.g.:
#   ALLOWED_HOSTS=127.0.0.1,localhost,healthcheck.railway.app,host.docker.internal
# See n8n/README.md section G for the full Docker networking explanation. Never carry
# host.docker.internal into a production ALLOWED_HOSTS value.
ALLOWED_HOSTS=127.0.0.1,localhost,healthcheck.railway.app
DATABASE_URL=sqlite:///./smritiraj.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

PUBLIC_BASE_URL=http://127.0.0.1:8000
# Base URL that n8n itself must use to reach this CRM's callback endpoint
# (POST /webhooks/n8n/delivery). This is NOT necessarily the same address as
# PUBLIC_BASE_URL — it must be reachable from wherever n8n is actually running,
# which is often a different network context than "the CRM's own public URL".
# Defaults to PUBLIC_BASE_URL if left blank.
#
# WARNING: "localhost" / "127.0.0.1" mean different machines depending on which
# side evaluates them. If n8n runs in Docker (e.g. Docker Desktop on Windows) and
# the CRM runs directly on the host, "localhost" inside the n8n container refers
# to the n8n container itself — NOT your Windows host — so n8n can never reach a
# callback_url built from 127.0.0.1/localhost. Use Docker's special DNS name for
# the host machine instead:
#   N8N_CALLBACK_BASE_URL=http://host.docker.internal:8000
# In production, use the CRM's real public/internal deployment URL (e.g. the
# Railway domain) — see docs/deployment-railway.md.
N8N_CALLBACK_BASE_URL=
HOSPITAL_NAME=Smriti Raj Dentistry
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_DELIVERY_MAX_RETRIES=3
DELIVERY_STALE_SENDING_SECONDS=300
# Temporary cutover switch only — leave false. See docs/blueprint/n8n-delivery-contract.md.
N8N_WEBHOOK_LEGACY_CALLBACK_COMPAT=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Generate locally with:
# py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store the generated key only in .env or your deployment secret manager.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
VALIDATION_RATE_LIMIT_ATTEMPTS=30
VALIDATION_RATE_LIMIT_WINDOW_SECONDS=60
